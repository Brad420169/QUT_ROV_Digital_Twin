<?xml version="1.0"?>
<scenario>

    <looks>
        <!-- QUT ROV looks -->
        <look name="rov_body" gray="1.0" roughness="0.4" metalness="0.2" texture="cad_model_data/rov_models/Real_ROV_colours.png"/>
        <look name="foam"  rgb="0.15 0.15 0.15" roughness="0.80"/>
        <look name="thruster" rgb="0.0 0.0 0.0" roughness="0.3" metalness="0.5"/>
        <look name="camera" rgb="0.10 0.10 0.10" roughness="0.40"/>
        <look name="default" rgb="1.0 1.0 1.0" roughness="1.0" metalness="0.0"/>
            </looks>

    <robot name="$(arg vehicle_name)" fixed="true" self_collisions="false">

        <base_link name="stability_anchor" type="sphere" physics="disabled" buoyant="false" collisions="false">
            <dimensions radius="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="HullMat"/>
            <look name="default"/>
        </base_link>

        <link name="stability_x" type="sphere" physics="disabled" buoyant="false" collisions="false">
            <dimensions radius="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="HullMat"/>
            <look name="default"/>
        </link>

        <link name="stability_y" type="sphere" physics="disabled" buoyant="false" collisions="false">
            <dimensions radius="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="HullMat"/>
            <look name="default"/>
        </link>

        <link name="stability_z" type="sphere" physics="disabled" buoyant="false" collisions="false">
            <dimensions radius="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="HullMat"/>
            <look name="default"/>
        </link>

        <link name="stability_yaw" type="sphere" physics="disabled" buoyant="false" collisions="false">
            <dimensions radius="0.00001"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <material name="HullMat"/>
            <look name="default"/>
        </link>

        <link name="base_link" type="model" physics="submerged">

        <!-- Both meshes are baked into NED (+X forward, +Y right, +Z down).
             OBJ units are centimetres; both mesh origins must remain identity. -->
            <physical>
                <mesh filename="cad_model_data/rov_models/phyiscal_meshes/Real_ROV_phy_ned.obj" scale="0.01"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </physical>

            <visual>
                <mesh filename="cad_model_data/rov_models/visual_meshes/Real_ROV_vis_ned.obj" scale="0.01"/>
                <origin rpy="0 0 0" xyz="0 0 0"/>
            </visual>

            <material name="HullMat"/>
            <look name="rov_body"/>
            <!-- Measured mass; idealised CG below CB to restore pitch toward level. -->
            <mass value="3.5"/>
            <inertia xyz="0.03 0.536 0.0535"/>
            <cg xyz="-0.08727407389761058 -0.0198125123563815 0.04" rpy="0 0 0"/>
        </link>


        <!-- Unlimited XYZ travel and yaw, followed by limited body-Y pitch. -->
        <joint name="free_stability_x" type="prismatic">
            <parent name="stability_anchor"/>
            <child name="stability_x"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="1 0 0"/>
            <damping value="0"/>
        </joint>
        <joint name="free_stability_y" type="prismatic">
            <parent name="stability_x"/>
            <child name="stability_y"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <damping value="0"/>
        </joint>
        <joint name="free_stability_z" type="prismatic">
            <parent name="stability_y"/>
            <child name="stability_z"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <damping value="0"/>
        </joint>
        <joint name="free_yaw" type="revolute">
            <parent name="stability_z"/>
            <child name="stability_yaw"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 0 1"/>
            <damping value="0"/>
        </joint>

        <!-- Viscous pitch damping; limits in radians. Small solver overshoot is possible. -->
        <joint name="limited_pitch" type="revolute">
            <parent name="stability_yaw"/>
            <child name="base_link"/>
            <origin xyz="0 0 0" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
            <limits min="-0.03490658503988659" max="0.03490658503988659"/>
            <damping value="0.3"/>
        </joint>

        <!-- Vertical thrust line 1 mm forward of CG; surge thrust plane at CG Z. -->
        <actuator name="TL" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.08627407389761058 -0.1598125123563815 -0.03" rpy="0 -1.5707963267948966 0"/>
            <specs max_setpoint="1200.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="1"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.00001"/>
            </thrust_model>
            <propeller diameter="0.077" right="false">
                <mesh filename="cad_model_data/thrusters/ccw_thruster.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <!-- Thruster TR -->
        <actuator name="TR" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.08627407389761058 0.1201874876436185 -0.03" rpy="0 -1.5707963267948966 0"/>
            <specs max_setpoint="1200.0" inverted_setpoint="true" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="1"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.00001"/>
            </thrust_model>
            <propeller diameter="0.077" right="true">
                <mesh filename="cad_model_data/thrusters/cw_thruster.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <!-- Thruster BL -->
        <actuator name="BL" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.1746 -0.1598125123563815 -0.03" rpy="0.0 0.0 0.0"/>
            <specs max_setpoint="1200.0" inverted_setpoint="false" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="1"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.00001"/>
            </thrust_model>
            <propeller diameter="0.077" right="true">
                <mesh filename="cad_model_data/thrusters/cw_thruster.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>

        <!-- Thruster BR -->
        <actuator name="BR" type="thruster">
            <link name="base_link"/>
            <origin xyz="-0.1746 0.1201874876436185 -0.03" rpy="0.0 0.0 0.0"/>
            <specs max_setpoint="1200.0" inverted_setpoint="true" normalized_setpoint="false"/>
            <rotor_dynamics type="zero_order"/>
            <thrust_model type="fluid_dynamics">
                <rotor_constant value="1"/>
                <thrust_coeff forward="0.043" reverse="0.043"/>
                <torque_coeff value="0.00001"/>
            </thrust_model>
            <propeller diameter="0.077" right="false">
                <mesh filename="cad_model_data/thrusters/ccw_thruster.obj" scale="1.0"/>
                <material name="Neutral"/>
                <look name="thruster"/>
            </propeller>
        </actuator>


        <sensor name="Cam" rate="60.0" type="camera">
            <specs resolution_x="480" resolution_y="360" horizontal_fov="75.0"/>
            <!-- <origin xyz="0.14816 -0.00046 -0.00106" rpy="1.5708 0 1.5708"/> -->
            <origin xyz="0.19 -0.00046 -0.00106" rpy="1.5708 0 1.5708"/>
            <link name="base_link"/>
            <ros_publisher topic="/$(arg vehicle_name)/left"/>
        </sensor>

        <!-- GPS reports no fix while submerged; motion HUD uses simulation truth. -->
        <sensor name="GPS" rate="10.0" type="gps">
            <noise ned_position="0.0"/>
            <history samples="1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="base_link"/>
            <ros_publisher topic="/$(arg vehicle_name)/gps"/>
        </sensor>

        <sensor name="IMU" rate="30.0" type="imu">
            <noise angle="0.0 0.0 0.0" angular_velocity="0.0" yaw_drift="0.0" linear_acceleration="0.0"/>
            <history samples="1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="base_link"/>
            <ros_publisher imu="IMU" topic="/$(arg vehicle_name)/imu"/>
        </sensor>

        <sensor name="Pressure" rate="30.0" type="pressure">
            <range pressure="200000.0"/>
            <noise pressure="0.5"/>
            <history samples="1"/>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0"/>
            <link name="base_link"/>
            <ros_publisher pressure="Pressure" topic="/$(arg vehicle_name)/pressure"/>
        </sensor>

                <!-- Transform + ROS -->
        <world_transform xyz="$(arg position)" rpy="$(arg orientation)"/>
        <!-- Report the moving vehicle, not the fixed constraint anchor. -->
        <ros_base_link_transform publish="true" link="base_link"/>
        <ros_subscriber thrusters="/$(arg vehicle_name)/setpoint/thrusters"/>

    </robot>


</scenario>



