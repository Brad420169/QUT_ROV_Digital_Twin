<?xml version="1.0"?>
<scenario>



    <environment>
        <ned latitude="56.136459" longitude="-2.706819"/>

        <ocean>
            <water density="1031.0" jerlov="0.15"/>
            <waves height="0.0"/>
            <particles enabled="false"/>
        </ocean>

        <atmosphere>
            <sun azimuth="45.0" elevation="90.0"/>
        </atmosphere>
    </environment>

    <materials>
        <material name="HullMat" density="1000.0" restitution="0.3"/>
        <material name="FoamMat" density="100.0" restitution="0.2"/>
        <material name="ElectronicsMat" density="1500.0" restitution="0.2"/>
        <material name="Neutral" density="1000.0" restitution="0.1"/>
		<material name="Rock" density="3000.0" restitution="0.8"/>
		<material name="Fiberglass" density="1500.0" restitution="0.3"/>
		<material name="Aluminium" density="2710.0" restitution="0.5"/>
		<material name="NeutralWater" density="1031.0" restitution="0.1"/>
		<friction_table>
			<friction material1="Neutral" material2="Neutral" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Rock" static="0.2" dynamic="0.1"/>
			<friction material1="Neutral" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Neutral" material2="Aluminium" static="0.1" dynamic="0.02"/>
			<friction material1="Rock" material2="Rock" static="0.9" dynamic="0.7"/>
			<friction material1="Rock" material2="Fiberglass" static="0.6" dynamic="0.4"/>
			<friction material1="Rock" material2="Aluminium" static="0.6" dynamic="0.3"/>
			<friction material1="Fiberglass" material2="Fiberglass" static="0.5" dynamic="0.2"/>
			<friction material1="Fiberglass" material2="Aluminium" static="0.5" dynamic="0.2"/>
			<friction material1="Aluminium" material2="Aluminium" static="0.8" dynamic="0.5"/>
		</friction_table>
    </materials>


    <looks>
	   	<look name="sand" gray="1.0" roughness="0.7" metalness="0.3" texture="cad_model_data/environment/corals/texture/SoilBeach0078_1_350.jpg"/>
		<look name="coral_map" gray="1.0" roughness="0.7" metalness="0.3" texture="cad_model_data/environment/corals/texture/coral_map.jpeg"/>
	</looks>


    <!-- defining objects in the environment -->
    <static name="Seabed" type="model">
		<physical>
			<mesh filename="cad_model_data/environment/corals/mesh/seabed.obj" scale="1.0"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 0.0 0.0"/>
		</physical>
		<material name="Rock"/>
		<look name="sand"/>
		<world_transform rpy="0.0 0.0 0.0" xyz="0.0 0.0 6.0"/>
	</static>

	<static name="Coralmap" type="model">
		<physical>
			<mesh filename="cad_model_data/environment/corals/mesh/coral_map.obj" scale="0.5"/>
			<origin rpy="0.0 0.0 0.0" xyz="0.0 3.0 0.0"/>
		</physical>
		<material name="Neutral"/>
		<look name="coral_map"/>
		<world_transform rpy="3.14 0 0" xyz="0 0.0 5"/>
	</static>

	<include file="$(param rov_scenario)">

        <arg name="vehicle_name" value="qut_rov"/>
        <arg name="position" value="1.0 1.0 3.0"/>
        <arg name="orientation" value="0.0 0.0 0.0"/>
	</include>

	<include file="$(find stonefish_qut_rov)/scenarios/fish_animated.scn">
	
		<arg name="vehicle_name" value="yellow_tang"/>
		<arg name="position" value="2.0 0.0 4.0"/>
		<arg name="orientation" value="0.0 0.0 0.0"/>
	</include>

</scenario>




